<mujoco model="stretch 4 scene">
  <!-- robot_descriptions' Stretch 3 scene.xml, turned to face the Stretch 4 arm:
       the table is in front of the robot (+x) instead of to its side (-y). -->
  <include file="stretch.xml"/>

  <statistic center="0.5 0 .75" extent="1.2" meansize="0.05"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="150" elevation="-20"/>
  </visual>

  <asset>
    <material name="floor" rgba=".1 .1 .1 1" reflectance="0.1"/>
    <material name="table" rgba=".55 .4 .25 1"/>
    <texture type="skybox" builtin="gradient" rgb1="0.44 0.80 1.00" rgb2="1 1 1" width="512" height="3072"/>
  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <!-- The omniwheel contact pairs in stretch.xml reference this geom by name. -->
    <geom name="floor" size="0 0 0.05" type="plane" material="floor"/>
    <body name="table" pos="1 0 .24">
      <geom type="box" size=".5 .6 .24" mass="1" material="table"/>
    </body>
    <body name="object1" pos="0.55 .02 .6">
      <freejoint/>
      <geom type="box" size=".04 .02 .04" mass=".5" rgba=".2 .2 .5 1"/>
    </body>
    <body name="object2" pos="0.55 -.08 .6">
      <freejoint/>
      <geom type="cylinder" size=".02 .04 .04" mass=".5" rgba=".8 .2 .2 1"/>
    </body>
  </worldbody>
</mujoco>
