<mujoco model="stretch demo: door opening">
  <!-- Door opening: grab the handle and pull the door open past the goal angle.
       The door is mujoco-sim's scenes/door.xml (robosuite's door asset), moved
       in front of the Stretch 4's forward-reaching arm. tasks/door.py scores it.
       Radians (compiler angle="radian" from stretch.xml). -->
  <include file="stretch.xml"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
  </visual>

  <asset>
    <texture file="robosuite_assets/textures/dark-wood.png" type="cube" name="rs_dark_wood"/>
    <texture file="robosuite_assets/textures/brass-ambra.png" type="cube" name="rs_metal"/>
    <texture type="skybox" builtin="gradient" rgb1="0.44 0.80 1.00" rgb2="1 1 1" width="512" height="3072"/>
    <material name="floor_mat" rgba=".12 .12 .12 1" reflectance="0.08"/>
    <material name="rs_metal_mat" texture="rs_metal" specular="1" shininess="0.3" rgba="0.9 0.9 0.9 1"/>
    <material name="rs_dark_wood_mat" texture="rs_dark_wood" texrepeat="3 3" specular="0.4" shininess="0.1"/>
  </asset>

  <worldbody>
    <light pos="0.6 0 2.4" dir="0 0 -1" directional="true"/>
    <geom name="floor" type="plane" size="0 0 0.05" material="floor_mat"/>

    <body name="robosuite_door_object" pos="0.772 -0.066 0.84">
      <body name="rs_frame" pos="0 0.22 0" quat="0.707388 0 0 -0.706825">
        <inertial pos="0.3 0 0" quat="0.5 0.5 0.5 0.5" mass="7.85398" diaginertia="0.923301 0.764585 0.168533"/>
        <geom name="rs_r_frame" type="cylinder" size="0.03 0.3" pos="0.555 0 0" rgba="1 1 1 1"/>
        <geom name="rs_l_frame" type="cylinder" size="0.03 0.3" pos="0.045 0 0" rgba="1 1 1 1"/>
        <body name="rs_door" pos="0.3 0 0">
          <inertial pos="0.0296816 -0.00152345 0" quat="0.701072 0 0 0.713091" mass="2.43455" diaginertia="0.0913751 0.0521615 0.043714"/>
          <joint name="rs_door_hinge" type="hinge" pos="0.255 0 0" axis="0 0 1"
                 range="0 0.8" damping=".4" frictionloss=".2" limited="true"/>
          <geom name="rs_panel" type="box" size="0.22 0.02 .29" friction="1 1 1" material="rs_dark_wood_mat"/>
          <body name="rs_latch" pos="-0.175 0 -0.025">
            <inertial pos="-0.017762 0.0138544 0" quat="0.365653 0.605347 -0.36522 0.605365" mass="0.1" diaginertia="0.0483771 0.0410001 0.0111013"/>
            <geom name="rs_handle_base" type="cylinder" fromto="0 0 0 0 -0.125 0" size="0.025" material="rs_metal_mat" condim="6" friction="1.5 0.02 0.1"/>
            <geom name="rs_handle" type="box" size="0.075 0.015 0.02" pos="0.075 -0.10 0" material="rs_metal_mat" condim="6" friction="1.5 0.02 0.1"/>
            <site name="rs_handle_site" pos="0.125 -0.10 0" size="0.02" rgba="0 0 1 0.35"/>
          </body>
        </body>
      </body>
    </body>
  </worldbody>
</mujoco>
